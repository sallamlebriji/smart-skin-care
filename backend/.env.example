DATABASE_URL=sqlite:///./data/smartskin.db
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# S3 / R2-compatible object storage for scan images (Phase 3+)
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=smart-skin-care-scans
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

CORS_ORIGINS=http://localhost:5173

DEBUG=true
SCAN_STORAGE_DIR=data/scans
MAX_UPLOAD_BYTES=5000000

# Optional: server-side chat credentials. Local replies work without a key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
WARM_MODEL_ON_STARTUP=false
MODEL_REGISTRY_DIR=data/models
