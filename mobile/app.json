{
  "expo": {
    "name": "Smart Skin Care",
    "slug": "smart-skin-care",
    "scheme": "smartskincare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartskincare.mobile",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.smartskincare.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      ["expo-camera", { "cameraPermission": "Take three face photos for your private skin journal.", "recordAudioAndroid": false }],
      ["expo-image-picker", { "photosPermission": "Select face photos to add to your skin journal.", "microphonePermission": false }]
    ]
  }
}
