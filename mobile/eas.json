{
  "cli": { "version": ">= 18.0.0", "appVersionSource": "local" },
  "build": {
    "base": { "node": "22.23.3" },
    "development": { "extends": "base", "developmentClient": true, "distribution": "internal" },
    "preview": { "extends": "base", "distribution": "internal", "android": { "buildType": "apk" }, "ios": { "simulator": true } },
    "production": { "extends": "base", "env": { "APP_ENV": "production", "EXPO_PUBLIC_REQUIRE_HTTPS": "true" } }
  }
}
